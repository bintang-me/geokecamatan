{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tunggal", "destination": "/" },
    { "source": "/tunggal/:koordinat", "destination": "/" },
    { "source": "/massal", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
